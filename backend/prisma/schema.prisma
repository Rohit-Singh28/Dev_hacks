generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────

model User {
    id           String   @id @default(uuid())
    username     String   @unique
    email        String   @unique
    passwordHash String?  @map("password_hash")
    googleId     String?  @unique @map("google_id")
    avatarUrl    String?  @map("avatar_url")
    rating       Int      @default(1200)
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    submissions         Submission[]
    contestParticipants ContestParticipant[]
    duelParticipations  DuelParticipant[]
    bookmarks           Bookmark[]
    dailyActivities     DailyActivity[]
    hostedRooms         Room[]               @relation("RoomHost")
    roomParticipants    RoomParticipant[]
    posts               Post[]
    comments            Comment[]
    postLikes           PostLike[]
    editorials          Editorial[]
    editorialVotes      EditorialVote[]

    @@index([username])
    @@index([email])
    @@index([rating])
    @@map("users")
}

// ─── Topics ──────────────────────────────────────────────────────────

model Topic {
    id          String   @id @default(uuid())
    name        String   @unique
    slug        String   @unique
    description String?  @db.Text
    icon        String?  // SVG icon name or emoji
    color       String?  // Hex color for UI
    orderIndex  Int      @default(0) @map("order_index")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    problems Problem[]

    @@index([slug])
    @@index([orderIndex])
    @@map("topics")
}

// ─── Problems ────────────────────────────────────────────────────────

enum Difficulty {
    EASY
    MEDIUM
    HARD
}

model Problem {
    id           String     @id @default(uuid())
    title        String
    slug         String     @unique
    description  String     @db.Text
    difficulty   Difficulty @default(MEDIUM)
    topicId      String?    @map("topic_id")
    timeLimit    Int        @default(2000) @map("time_limit") // ms
    memoryLimit  Int        @default(262144) @map("memory_limit") // KB (256MB)
    sampleInput  String?    @map("sample_input") @db.Text
    sampleOutput String?    @map("sample_output") @db.Text
    constraints  String?    @db.Text
    createdAt    DateTime   @default(now()) @map("created_at")
    updatedAt    DateTime   @updatedAt @map("updated_at")

    topic                       Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
    testCases                   TestCase[]
    submissions                 Submission[]
    contestProblems             ContestProblem[]
    duelProblems                DuelProblem[]
    duelParticipantSubmissions  DuelParticipantSubmission[]
    roomProblems    RoomProblem[]
    bookmarks       Bookmark[]
    hints           Hint[]
    editorials      Editorial[]

    @@index([slug])
    @@index([difficulty])
    @@index([topicId])
    @@map("problems")
}

// ─── Test Cases ──────────────────────────────────────────────────────

model TestCase {
    id         String  @id @default(uuid())
    problemId  String  @map("problem_id")
    input      String  @db.Text
    output     String  @db.Text
    isHidden   Boolean @default(false) @map("is_hidden")
    orderIndex Int     @default(0) @map("order_index")

    problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@index([problemId, isHidden])
    @@map("test_cases")
}

// ─── Contests ────────────────────────────────────────────────────────

enum ContestStatus {
    UPCOMING
    ACTIVE
    ENDED
}

model Contest {
    id          String        @id @default(uuid())
    title       String
    slug        String        @unique
    description String?       @db.Text
    startTime   DateTime      @map("start_time")
    endTime     DateTime      @map("end_time")
    status      ContestStatus @default(UPCOMING)
    createdAt   DateTime      @default(now()) @map("created_at")
    updatedAt   DateTime      @updatedAt @map("updated_at")

    contestProblems     ContestProblem[]
    contestParticipants ContestParticipant[]
    submissions         Submission[]

    @@index([status])
    @@index([startTime, endTime])
    @@index([slug])
    @@map("contests")
}

// ─── Contest ↔ Problem (many-to-many with ordering + scores) ────────

model ContestProblem {
    id        String @id @default(uuid())
    contestId String @map("contest_id")
    problemId String @map("problem_id")
    label     String // e.g. "A", "B", "C"
    points    Int    @default(100)
    orderIdx  Int    @default(0) @map("order_idx")

    contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
    problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@unique([contestId, problemId])
    @@unique([contestId, label])
    @@index([contestId])
    @@map("contest_problems")
}

// ─── Contest Participants ────────────────────────────────────────────

model ContestParticipant {
    id        String   @id @default(uuid())
    contestId String   @map("contest_id")
    userId    String   @map("user_id")
    score     Int      @default(0)
    penalty   Int      @default(0) // total penalty in seconds
    rank      Int?
    joinedAt  DateTime @default(now()) @map("joined_at")

    contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([contestId, userId])
    @@index([contestId, score, penalty])
    @@map("contest_participants")
}

// ─── Submissions ─────────────────────────────────────────────────────

enum Verdict {
    PENDING
    RUNNING
    ACCEPTED
    WRONG_ANSWER
    TIME_LIMIT_EXCEEDED
    MEMORY_LIMIT_EXCEEDED
    RUNTIME_ERROR
    COMPILATION_ERROR
}

enum Language {
    CPP // Judge0 id: 54
    PYTHON // Judge0 id: 71
    JAVA // Judge0 id: 62
}

model Submission {
    id            String   @id @default(uuid())
    userId        String   @map("user_id")
    problemId     String   @map("problem_id")
    contestId     String?  @map("contest_id")
    roomId        String?  @map("room_id")
    language      Language
    sourceCode    String   @map("source_code") @db.Text
    verdict       Verdict  @default(PENDING)
    executionTime Int?     @map("execution_time") // ms
    memoryUsed    Int?     @map("memory_used") // KB
    testsPassed   Int      @default(0) @map("tests_passed")
    testsTotal    Int      @default(0) @map("tests_total")
    compileOutput String?  @map("compile_output") @db.Text
    stderr        String?  @db.Text
    isContest     Boolean  @default(false) @map("is_contest")
    createdAt     DateTime @default(now()) @map("created_at")

    user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
    contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
    duelParticipantSubmission DuelParticipantSubmission?
    room    Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

    @@index([userId, problemId])
    @@index([contestId, userId, problemId])
    @@index([roomId, userId, problemId])
    @@index([verdict])
    @@index([createdAt])
    @@map("submissions")
}

// ─── Duels (1v1 Code Battles) ────────────────────────────────────────

enum DuelStatus {
    WAITING
    IN_PROGRESS
    COMPLETED
    ABANDONED
}

enum DuelTimerOption {
    TEN_MINS       // 10 minutes — 1 Easy
    THIRTY_MINS    // 30 minutes — 1 Easy + 1 Medium
    ONE_HOUR       // 1 hour     — 1 Easy + 1 Medium + 1 Hard
}

model Duel {
    id          String           @id @default(uuid())
    timerOption DuelTimerOption  @map("timer_option")
    status      DuelStatus       @default(WAITING)
    startedAt   DateTime?        @map("started_at")
    endedAt     DateTime?        @map("ended_at")
    createdAt   DateTime         @default(now()) @map("created_at")
    updatedAt   DateTime         @updatedAt @map("updated_at")

    problems     DuelProblem[]
    participants DuelParticipant[]

    @@index([status])
    @@index([createdAt])
    @@map("duels")
}

model DuelProblem {
    id        String @id @default(uuid())
    duelId    String @map("duel_id")
    problemId String @map("problem_id")
    label     String // "A", "B", "C"
    orderIdx  Int    @default(0) @map("order_idx")

    duel    Duel    @relation(fields: [duelId], references: [id], onDelete: Cascade)
    problem Problem @relation(fields: [problemId], references: [id])

    @@unique([duelId, problemId])
    @@unique([duelId, label])
    @@index([duelId])
    @@map("duel_problems")
}

model DuelParticipant {
    id              String    @id @default(uuid())
    duelId          String    @map("duel_id")
    userId          String    @map("user_id")
    ratingBefore    Int       @map("rating_before")
    ratingAfter     Int?      @map("rating_after")
    isWinner        Boolean?  @map("is_winner")
    joinedAt        DateTime  @default(now()) @map("joined_at")

    duel        Duel        @relation(fields: [duelId], references: [id], onDelete: Cascade)
    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    submissions DuelParticipantSubmission[]

    @@unique([duelId, userId])
    @@index([duelId])
    @@index([userId])
    @@map("duel_participants")
}

model DuelParticipantSubmission {
    id              String    @id @default(uuid())
    participantId   String    @map("participant_id")
    problemId       String    @map("problem_id")
    submissionId    String?   @map("submission_id") @unique
    solved          Boolean   @default(false)
    createdAt       DateTime  @default(now()) @map("created_at")

    participant DuelParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
    problem     Problem         @relation(fields: [problemId], references: [id])
    submission  Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)

    @@unique([participantId, problemId])
    @@index([participantId])
    @@map("duel_participant_submissions")
}

// ─── Duel Queue (for matchmaking) ────────────────────────────────────

model DuelQueue {
    id          String          @id @default(uuid())
    userId      String          @map("user_id")
    timerOption DuelTimerOption @map("timer_option")
    minRating   Int             @map("min_rating")
    maxRating   Int             @map("max_rating")
    queuedAt    DateTime        @default(now()) @map("queued_at")

    @@index([timerOption, minRating, maxRating])
    @@index([userId])
    @@map("duel_queues")
}

// ─── Bookmarks ───────────────────────────────────────────────────────

model Bookmark {
    id        String   @id @default(uuid())
    userId    String   @map("user_id")
    problemId String   @map("problem_id")
    note      String?  @db.Text
    createdAt DateTime @default(now()) @map("created_at")

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@unique([userId, problemId])
    @@index([userId])
    @@map("bookmarks")
}

// ─── Hints ───────────────────────────────────────────────────────────

model Hint {
    id        String @id @default(uuid())
    problemId String @map("problem_id")
    content   String @db.Text
    orderIdx  Int    @default(0) @map("order_idx")

    problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@index([problemId])
    @@map("hints")
}

// ─── Daily Activity (streak tracking) ────────────────────────────────

model DailyActivity {
    id              String   @id @default(uuid())
    userId          String   @map("user_id")
    date            DateTime @db.Date
    solvedCount     Int      @default(0) @map("solved_count")
    submissionCount Int      @default(0) @map("submission_count")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, date])
    @@index([userId, date])
    @@map("daily_activities")
}

// ─── Rooms (User-Hosted Contests) ───────────────────────────────────

enum RoomStatus {
    WAITING
    ACTIVE
    ENDED
}

model Room {
    id        String     @id @default(uuid())
    roomCode  String     @unique @map("room_code")
    title     String
    hostId    String     @map("host_id")
    status    RoomStatus @default(WAITING)
    duration  Int        @default(60) // minutes
    startTime DateTime?  @map("start_time")
    endTime   DateTime?  @map("end_time")
    createdAt DateTime   @default(now()) @map("created_at")
    updatedAt DateTime   @updatedAt @map("updated_at")

    host             User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
    roomProblems     RoomProblem[]
    roomParticipants RoomParticipant[]
    submissions      Submission[]

    @@index([roomCode])
    @@index([hostId])
    @@index([status])
    @@map("rooms")
}

// ─── Room ↔ Problem (many-to-many with ordering) ────────────────────

model RoomProblem {
    id        String @id @default(uuid())
    roomId    String @map("room_id")
    problemId String @map("problem_id")
    label     String // "A", "B", "C", "D"
    points    Int    @default(100)
    orderIdx  Int    @default(0) @map("order_idx")

    room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
    problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@unique([roomId, problemId])
    @@unique([roomId, label])
    @@index([roomId])
    @@map("room_problems")
}

// ─── Room Participants ───────────────────────────────────────────────

model RoomParticipant {
    id       String   @id @default(uuid())
    roomId   String   @map("room_id")
    userId   String   @map("user_id")
    score    Int      @default(0)
    penalty  Int      @default(0)
    rank     Int?
    joinedAt DateTime @default(now()) @map("joined_at")

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([roomId, userId])
    @@index([roomId, score, penalty])
    @@map("room_participants")
}

// ─── Weekly Contests (Admin-managed) ─────────────────────────────────

model WeeklyContest {
    id          String     @id @default(uuid())
    title       String
    slug        String     @unique
    description String?    @db.Text
    startDate   DateTime   @map("start_date")
    endDate     DateTime   @map("end_date")
    difficulty  Difficulty @default(MEDIUM)
    prizes      String?    @db.Text
    isActive    Boolean    @default(true) @map("is_active")
    createdAt   DateTime   @default(now()) @map("created_at")
    updatedAt   DateTime   @updatedAt @map("updated_at")

    @@index([isActive, startDate, endDate])
    @@index([slug])
    @@map("weekly_contests")
}

// ─── Community Posts ─────────────────────────────────────────────────

model Post {
    id        String   @id @default(uuid())
    authorId  String   @map("author_id")
    title     String
    content   String   @db.Text
    tags      String?  // comma-separated tags
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
    comments Comment[]
    likes    PostLike[]

    @@index([authorId])
    @@index([createdAt])
    @@map("posts")
}

model Comment {
    id        String   @id @default(uuid())
    postId    String   @map("post_id")
    authorId  String   @map("author_id")
    content   String   @db.Text
    parentId  String?  @map("parent_id") // for nested replies
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
    author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
    parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies Comment[] @relation("CommentReplies")

    @@index([postId])
    @@index([authorId])
    @@index([parentId])
    @@map("comments")
}

model PostLike {
    id        String   @id @default(uuid())
    postId    String   @map("post_id")
    userId    String   @map("user_id")
    createdAt DateTime @default(now()) @map("created_at")

    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([postId, userId])
    @@index([postId])
    @@index([userId])
    @@map("post_likes")
}

// ─── Community Editorials ────────────────────────────────────────────

model Editorial {
    id        String   @id @default(uuid())
    problemId String   @map("problem_id")
    authorId  String   @map("author_id")
    title     String
    content   String   @db.LongText
    language  String?  // optional: language used in solution
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    problem Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
    author  User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
    votes   EditorialVote[]

    @@index([problemId])
    @@index([authorId])
    @@index([createdAt])
    @@map("editorials")
}

model EditorialVote {
    id          String   @id @default(uuid())
    editorialId String   @map("editorial_id")
    userId      String   @map("user_id")
    value       Int      // 1 for upvote, -1 for downvote
    createdAt   DateTime @default(now()) @map("created_at")

    editorial Editorial @relation(fields: [editorialId], references: [id], onDelete: Cascade)
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([editorialId, userId])
    @@index([editorialId])
    @@index([userId])
    @@map("editorial_votes")
}
