generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────

model User {
    id           String   @id @default(uuid())
    username     String   @unique
    email        String   @unique
    passwordHash String   @map("password_hash")
    rating       Int      @default(1200)
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    submissions         Submission[]
    contestParticipants ContestParticipant[]
    duelParticipations  DuelParticipant[]

    @@index([username])
    @@index([email])
    @@index([rating])
    @@map("users")
}

// ─── Problems ────────────────────────────────────────────────────────

enum Difficulty {
    EASY
    MEDIUM
    HARD
}

model Problem {
    id           String     @id @default(uuid())
    title        String
    slug         String     @unique
    description  String     @db.Text
    difficulty   Difficulty @default(MEDIUM)
    timeLimit    Int        @default(2000) @map("time_limit") // ms
    memoryLimit  Int        @default(262144) @map("memory_limit") // KB (256MB)
    sampleInput  String?    @map("sample_input") @db.Text
    sampleOutput String?    @map("sample_output") @db.Text
    constraints  String?    @db.Text
    createdAt    DateTime   @default(now()) @map("created_at")
    updatedAt    DateTime   @updatedAt @map("updated_at")

    testCases                   TestCase[]
    submissions                 Submission[]
    contestProblems             ContestProblem[]
    duelProblems                DuelProblem[]
    duelParticipantSubmissions  DuelParticipantSubmission[]

    @@index([slug])
    @@index([difficulty])
    @@map("problems")
}

// ─── Test Cases ──────────────────────────────────────────────────────

model TestCase {
    id         String  @id @default(uuid())
    problemId  String  @map("problem_id")
    input      String  @db.Text
    output     String  @db.Text
    isHidden   Boolean @default(false) @map("is_hidden")
    orderIndex Int     @default(0) @map("order_index")

    problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@index([problemId, isHidden])
    @@map("test_cases")
}

// ─── Contests ────────────────────────────────────────────────────────

enum ContestStatus {
    UPCOMING
    ACTIVE
    ENDED
}

model Contest {
    id          String        @id @default(uuid())
    title       String
    slug        String        @unique
    description String?       @db.Text
    startTime   DateTime      @map("start_time")
    endTime     DateTime      @map("end_time")
    status      ContestStatus @default(UPCOMING)
    createdAt   DateTime      @default(now()) @map("created_at")
    updatedAt   DateTime      @updatedAt @map("updated_at")

    contestProblems     ContestProblem[]
    contestParticipants ContestParticipant[]
    submissions         Submission[]

    @@index([status])
    @@index([startTime, endTime])
    @@index([slug])
    @@map("contests")
}

// ─── Contest ↔ Problem (many-to-many with ordering + scores) ────────

model ContestProblem {
    id        String @id @default(uuid())
    contestId String @map("contest_id")
    problemId String @map("problem_id")
    label     String // e.g. "A", "B", "C"
    points    Int    @default(100)
    orderIdx  Int    @default(0) @map("order_idx")

    contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
    problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@unique([contestId, problemId])
    @@unique([contestId, label])
    @@index([contestId])
    @@map("contest_problems")
}

// ─── Contest Participants ────────────────────────────────────────────

model ContestParticipant {
    id        String   @id @default(uuid())
    contestId String   @map("contest_id")
    userId    String   @map("user_id")
    score     Int      @default(0)
    penalty   Int      @default(0) // total penalty in seconds
    rank      Int?
    joinedAt  DateTime @default(now()) @map("joined_at")

    contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([contestId, userId])
    @@index([contestId, score, penalty])
    @@map("contest_participants")
}

// ─── Submissions ─────────────────────────────────────────────────────

enum Verdict {
    PENDING
    RUNNING
    ACCEPTED
    WRONG_ANSWER
    TIME_LIMIT_EXCEEDED
    MEMORY_LIMIT_EXCEEDED
    RUNTIME_ERROR
    COMPILATION_ERROR
}

enum Language {
    CPP // Judge0 id: 54
    PYTHON // Judge0 id: 71
    JAVA // Judge0 id: 62
}

model Submission {
    id            String   @id @default(uuid())
    userId        String   @map("user_id")
    problemId     String   @map("problem_id")
    contestId     String?  @map("contest_id")
    language      Language
    sourceCode    String   @map("source_code") @db.Text
    verdict       Verdict  @default(PENDING)
    executionTime Int?     @map("execution_time") // ms
    memoryUsed    Int?     @map("memory_used") // KB
    testsPassed   Int      @default(0) @map("tests_passed")
    testsTotal    Int      @default(0) @map("tests_total")
    compileOutput String?  @map("compile_output") @db.Text
    stderr        String?  @db.Text
    isContest     Boolean  @default(false) @map("is_contest")
    createdAt     DateTime @default(now()) @map("created_at")

    user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
    contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
    duelParticipantSubmission DuelParticipantSubmission?

    @@index([userId, problemId])
    @@index([contestId, userId, problemId])
    @@index([verdict])
    @@index([createdAt])
    @@map("submissions")
}

// ─── Duels (1v1 Code Battles) ────────────────────────────────────────

enum DuelStatus {
    WAITING
    IN_PROGRESS
    COMPLETED
    ABANDONED
}

enum DuelTimerOption {
    TEN_MINS       // 10 minutes — 1 Easy
    THIRTY_MINS    // 30 minutes — 1 Easy + 1 Medium
    ONE_HOUR       // 1 hour     — 1 Easy + 1 Medium + 1 Hard
}

model Duel {
    id          String           @id @default(uuid())
    timerOption DuelTimerOption  @map("timer_option")
    status      DuelStatus       @default(WAITING)
    startedAt   DateTime?        @map("started_at")
    endedAt     DateTime?        @map("ended_at")
    createdAt   DateTime         @default(now()) @map("created_at")
    updatedAt   DateTime         @updatedAt @map("updated_at")

    problems     DuelProblem[]
    participants DuelParticipant[]

    @@index([status])
    @@index([createdAt])
    @@map("duels")
}

model DuelProblem {
    id        String @id @default(uuid())
    duelId    String @map("duel_id")
    problemId String @map("problem_id")
    label     String // "A", "B", "C"
    orderIdx  Int    @default(0) @map("order_idx")

    duel    Duel    @relation(fields: [duelId], references: [id], onDelete: Cascade)
    problem Problem @relation(fields: [problemId], references: [id])

    @@unique([duelId, problemId])
    @@unique([duelId, label])
    @@index([duelId])
    @@map("duel_problems")
}

model DuelParticipant {
    id              String    @id @default(uuid())
    duelId          String    @map("duel_id")
    userId          String    @map("user_id")
    ratingBefore    Int       @map("rating_before")
    ratingAfter     Int?      @map("rating_after")
    isWinner        Boolean?  @map("is_winner")
    joinedAt        DateTime  @default(now()) @map("joined_at")

    duel        Duel        @relation(fields: [duelId], references: [id], onDelete: Cascade)
    user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    submissions DuelParticipantSubmission[]

    @@unique([duelId, userId])
    @@index([duelId])
    @@index([userId])
    @@map("duel_participants")
}

model DuelParticipantSubmission {
    id              String    @id @default(uuid())
    participantId   String    @map("participant_id")
    problemId       String    @map("problem_id")
    submissionId    String?   @map("submission_id") @unique
    solved          Boolean   @default(false)
    createdAt       DateTime  @default(now()) @map("created_at")

    participant DuelParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
    problem     Problem         @relation(fields: [problemId], references: [id])
    submission  Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)

    @@unique([participantId, problemId])
    @@index([participantId])
    @@map("duel_participant_submissions")
}

// ─── Duel Queue (for matchmaking) ────────────────────────────────────

model DuelQueue {
    id          String          @id @default(uuid())
    userId      String          @map("user_id")
    timerOption DuelTimerOption @map("timer_option")
    minRating   Int             @map("min_rating")
    maxRating   Int             @map("max_rating")
    queuedAt    DateTime        @default(now()) @map("queued_at")

    @@index([timerOption, minRating, maxRating])
    @@index([userId])
    @@map("duel_queues")
}
